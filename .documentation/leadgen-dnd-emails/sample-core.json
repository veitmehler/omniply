      { "name": "padding-top", "default": 10, "unit": "px" },
      { "name": "padding-bottom", "default": 20, "unit": "px" },
      { "name": "padding-left", "default": 20, "unit": "px" },
      { "name": "padding-right", "default": 20, "unit": "px" },
      { "name": "container-background-color", "default": "" }
    ],
    "content": "<p style=\"text-align: left;line-height: 1.25;\"><span style=\"font-size: 12px\">{{location.full_address}}</span></p><p style=\"margin: 0px;font-size: 16px;padding-left: 0px !important;font-family: verdana, geneva, sans-serif;\"><span style=\"font-size: 12px\">You requested this guide on our website. Don't want these emails? </span><br><span style=\"font-size: 12px\">Unsubscribe </span><a target=\"_self\" rel=\"noopener noreferrer nofollow\" href=\"{{unsubscribe_link}}\" title=\"here\"><span style=\"font-size: 12px\">here</span></a><span style=\"font-size: 12px\">.</span></p>",
    "tagName": "mj-text"
  },
  "templateSettings": {
    "body": [
      { "default": 600, "name": "width", "unit": "px" },
      { "default": "#EAF0F6", "name": "background-color" },
      { "default": "#ffffff", "name": "body-color" },
      { "default": 0, "name": "border-width" },
