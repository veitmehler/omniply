  "previewUrlAttrs": {
    "attributes": [
      { "name": "enable-padding", "default": true },
      { "name": "padding-top", "default": 20, "unit": "px" },
      { "name": "padding-bottom", "default": 10, "unit": "px" },
      { "name": "padding-left", "default": 20, "unit": "px" },
      { "name": "padding-right", "default": 20, "unit": "px" },
      { "name": "line-height", "default": 1.25 },
      { "name": "font-family", "default": "arial, helvetica, sans-serif" },
      { "name": "font-size", "default": 14, "unit": "px" },
      { "name": "font-family-paragraph", "default": "arial, helvetica, sans-serif" },
      { "name": "container-background-color", "default": "" }
    ],
    "content": "<p style=\"text-align: center;\"><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"{{email.view_in_browser_url}}\">View this email in browser</a></p>",
    "tagName": "mj-preview-url"
  },
  "mainTextAttrs": {
    "attributes": [
