{
  "name": "socioply",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @socioply/web dev",
    "build": "pnpm --filter @socioply/web build",
    "dev:api": "pnpm --filter @socioply/api dev",
    "build:api": "pnpm --filter @socioply/api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7.0.0 <7.29.0": "^7.29.0",
      "fast-uri@<3.1.6": "^3.1.6"
    }
  }
}
