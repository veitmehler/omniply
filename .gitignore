# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (legacy root build + monorepo location)
/.next/
/out/
apps/web/.next/
apps/web/out/

# api build output
apps/api/dist/

# prisma generated clients (regenerated by prisma generate)
apps/web/src/generated/
apps/api/src/generated/
packages/db/src/generated/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
apps/web/next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# lock files (only keep pnpm)
package-lock.json
yarn.lock

# shared package build output (regenerated by build)
packages/shared/dist/
.vscode/
