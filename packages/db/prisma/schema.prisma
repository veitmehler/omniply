// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A tenant: up to 3 Users share one Account with equal permissions. Brand-level
// singletons (BrandSettings, GhlSettings, newsletter routing) and all content are
// shared across an Account's members.
model Account {
  id          String   @id @default(cuid())
  name        String?
  ownerUserId String?  @unique // the creating user (scalar, not a relation, to avoid a 2nd User↔Account relation)
  // Default "assistant" recipient for collaborative edit requests (Phase 7);
  // overridable per send. Usually one of the account's members.
  assistantEmail String?
  // Auto-routed admin-curated article calendar (specialization × hemisphere).
  articleCalendarId String?
  articleCalendar   ArticleCalendar? @relation(fields: [articleCalendarId], references: [id], onDelete: SetNull)
  // Billing-cycle anchor (see .plans/content-plan-billing-window.implementation-plan.md).
  // Re-anchored on EVERY payment_cleared event (multi-tenancy plan Phase B) — a
  // reactivation after a gap is just a payment. Nullable: unset accounts keep the
  // legacy rolling-30-day-from-today Content Plan behavior.
  subscriptionStartedAt DateTime?
  // Lifecycle state machine (.plans/multi-tenancy-hardening.implementation-plan.md Phase A).
  // Invariant: paidThrough governs publishing; status governs generation.
  status          String    @default("active") // active | paused | cancelled
  statusChangedAt DateTime? // drives the 60d pause→cancel and 90d cancel→delete clocks
  paidThrough     DateTime? // null = legacy/unbilled account, publishing unrestricted
  billingExempt   Boolean   @default(false) // comp accounts: bypass both gates
  // Per-account URL token for the GHL billing webhook receiver (Phase B) —
  // the GHL workflow posts to /api/ghl/billing-events/<token>.
  ghlBillingToken String?   @unique
  billingEvents   GhlBillingEvent[]
  // Stripe-central billing (2026-07-24): bound on FIRST payment via email/
  // contact match (two-phase, like owner promotion); renewals map directly.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  ghlContactId         String? // buyer's contact in the selling location (Stripe metadata)
  // Per-account URL token for the GHL Review-Received webhook receiver
  // (google-reviews plan Tier 3) — workflow posts to /api/ghl/reviews/<token>.
  ghlReviewToken  String?   @unique
  // Social DM agent webhook token (custom value omniply_dm_webhook).
  ghlDmToken     String?   @unique
  // Onboarding gate (.plans/ghl-onboarding.implementation-plan.md): first
  // generation is blocked until the chat onboarding completes (validator green).
  onboardingCompletedAt DateTime?
  onboardingSession     OnboardingSession?
  // Central lead-gen Drive folder for this account (leadgen plan Phase 1).
  driveFolderId String?
  leadGenDocuments LeadGenDocument[]
  leadCaptures     LeadCapture[]
  // Platform vertical (.plans/vertical-platform.implementation-plan.md):
  // selects the prompt seed set + subdomain family. 'chiro' has no override
  // prompt rows, so it resolves to the 'default' set unchanged.
  vertical String @default("chiro")
  // Public token identifying this account's chat-agent widget
  // (.plans/chat-agent-v1.implementation-plan.md) — same URL-token pattern as
  // ghlBillingToken/ghlReviewToken. Minted at provisioning.
  agentWidgetToken   String?             @unique
  agentConversations AgentConversation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members User[]          @relation("AccountMembers")
  roster  AccountMember[]
  newsletterTopicOverrides NewsletterTopic[]
  clientStories            ClientStory[]
  rawReviews               RawReview[]
  clientStorySpiderRuns    ClientStorySpiderRun[]

  @@index([articleCalendarId])
  @@map("accounts")
}

// Owner-managed roster of teammate emails (no invitations). A user whose email
// matches a roster entry is auto-joined to that account on sign-in.
// ── Lead-gen documents (.plans/leadgen-drive-documents.implementation-plan.md) ──

// Admin-managed master template (Model B): designed HTML layout with
// {{brand.*}} tokens and <slot name="..."> content slots.
model LeadGenTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sourceHtml  String   @db.Text
  slotMeta    Json? // per-slot: { maxChars, rewriteEligible }
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  documents   LeadGenDocument[]

  @@map("leadgen_templates")
}

model LeadGenDocument {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId      String // owner user (account-scoped queries broaden via extension)
  templateId  String?
  template    LeadGenTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title       String
  slug        String
  kind        String   @default("template") // template | custom
  status      String   @default("compiling") // compiling | pending_review | live | disabled | failed
  driveFileId String?  @unique
  driveLink   String? // webViewLink handed to marketing surfaces
  // ACL rotation (2026-07-29): Drive caps ~600 direct shares/file. Recompiles
  // create a NEW file (fresh budget) and ARCHIVE the old one (leads keep
  // access); rotatedAt anchors the shares-since counter for auto-rotation.
  archivedDriveFileIds String[] @default([])
  rotatedAt            DateTime?
  pdfKey      String? // S3 copy (source of truth for re-uploads)
  sourcePdfKey String? // custom uploads: the original client PDF on S3
  ghlTagNames String[] // applied to captured leads
  lastError   String?
  compiledAt  DateTime?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  captures    LeadCapture[]

  @@unique([accountId, slug])
  @@index([status])
  @@map("leadgen_documents")
}

// Capture log: one row per access proposal (idempotency + analytics).
model LeadCapture {
  id             String   @id @default(cuid())
  documentId     String
  document       LeadGenDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  requesterEmail String
  proposalId     String   @unique // dedupe across poll ticks
  ghlContactId   String?
  status         String   @default("captured") // captured | ghl_failed
  createdAt      DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("lead_captures")
}

// Resumable chat-onboarding state (.plans/ghl-onboarding.implementation-plan.md
// Phase 1). One session per account; every answer persists immediately so a
// closed tab resumes mid-flow.
model OnboardingSession {
  id          String   @id @default(cuid())
  accountId   String   @unique
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currentStep String   @default("welcome")
  status      String   @default("in_progress") // in_progress | completed
  stepData    Json? // per-step answers, extraction candidates, confirmations
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("onboarding_sessions")
}

// Agency-level OAuth grant from the marketplace app install (auto-provisioning).
// One row per GHL company; the agency access token mints per-location tokens.
model GhlAppToken {
  id           String   @id @default(cuid())
  companyId    String   @unique
  accessToken  String   @db.Text // encrypted
  refreshToken String   @db.Text // encrypted
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ghl_app_tokens")
}

// Audit log + idempotency window for GHL billing webhook events (multi-tenancy
// plan Phase B). One row per received event, including suppressed duplicates.
// Stripe webhook idempotency + unmatched-event holding table (Stripe-central
// billing, 2026-07-24). Unmatched rows (buyer paid with a different email)
// retry on later events and can be resolved manually at launch scale.
model StripeEvent {
  id             String   @id @default(cuid())
  stripeEventId  String   @unique // Stripe's evt_… id — idempotency key
  type           String
  email          String?
  contactId      String?
  subscriptionId String?
  accountId      String? // resolved account (null = held/unmatched)
  matched        Boolean  @default(false)
  raw            Json?
  createdAt      DateTime @default(now())

  @@index([matched, createdAt])
  @@index([subscriptionId])
  @@map("stripe_events")
}

model GhlBillingEvent {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      String // payment_cleared | payment_failed | cancelled
  duplicate Boolean  @default(false) // suppressed by the idempotency window
  raw       Json?
  createdAt DateTime @default(now())

  @@index([accountId, type, createdAt])
  @@map("ghl_billing_events")
}

model AccountMember {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email           String   @unique // lowercased; an email belongs to at most one team
  name            String?
  clerkInvitationId String? // Clerk invitation (closed sign-ups → invite-only)
  inviteUrl       String?  @db.Text // copyable invitation link for the owner to share
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
  @@map("account_members")
}

model User {
  id        String   @id @default(cuid())
  // GHL-SSO users carry a synthetic id ("ghl:<ghlUserId>") here so every
  // clerkId-keyed code path works unchanged (onboarding plan Phase 0).
  clerkId   String   @unique
  // Set for users who arrived via the embedded GHL app (SSO context userId).
  // NOT globally unique: the same GHL human (agency admin, multi-clinic owner)
  // gets one row per account — see @@unique([accountId, ghlUserId]).
  ghlUserId String?
  name      String?
  email     String   @unique
  role      String   @default("user") // user | admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Account membership (tenant). Nullable during rollout; backfilled 1 account per user.
  accountId String?
  account   Account? @relation("AccountMembers", fields: [accountId], references: [id], onDelete: SetNull)

  // Relations
  drafts               Draft[]
  posts                Post[]
  apiKeys              ApiKey[]
  settings             Settings?
  brandSettings        BrandSettings?
  templates            Template[]
  socialConnections    SocialConnection[]
  twitterApiRequests   TwitterApiRequest[]
  topics               Topic[]
  articleJobs          ArticleJob[]
  llmUsage             LLMUsage[]
  wordPressConnections WordPressConnection[]
  errorLogs            ErrorLog[]
  media                Media[]
  sectionEnrichments   SectionEnrichment[]
  ghlSettings          GhlSettings?
  socialAutomationRuns SocialAutomationRun[]
  socialPostSpecs      SocialPostSpec[]

  // Newsletter pipeline — the single calendar explicitly assigned to this customer
  newsletterCalendarId String?
  newsletterCalendar   NewsletterCalendar? @relation("UserNewsletterCalendar", fields: [newsletterCalendarId], references: [id], onDelete: SetNull)
  newsletters          Newsletter[]
  newsletterOffers     NewsletterOffer[]

  @@unique([accountId, ghlUserId])
  @@index([ghlUserId])
  @@index([newsletterCalendarId])
  @@index([accountId])
  @@map("users")
}

model Draft {
  id                      String    @id @default(cuid())
  userId                  String
  title                   String // Short title/preview
  contentRaw              String    @db.Text // User's original idea
  linkedinContent         String?   @db.Text // AI-generated LinkedIn post
  twitterContent          String?   @db.Text // AI-generated Twitter post
  facebookContent         String?   @db.Text // AI-generated Facebook post
  instagramContent        String?   @db.Text // AI-generated Instagram post
  telegramContent         String?   @db.Text // AI-generated Telegram post
  threadsContent          String?   @db.Text // AI-generated Threads post
  platforms               String // JSON array: ["linkedin", "twitter", "facebook", etc.] or "all" (or "both" for backward compatibility)
  templateId              String? // Which template was used
  attachedImage           String? // Supabase Storage URL (not base64)
  imageGenerationPrompt   String?   @db.Text // Store the prompt used for image generation
  imageGenerationProvider String? // Which provider was used (fal, openai-dalle, replicate)
  status                  String    @default("draft") // draft, published
  publishedAt             DateTime? // When the draft was published
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[] // A draft can result in multiple posts (one per platform)

  @@index([userId, status])
  @@map("drafts")
}

model Post {
  id                    String               @id @default(cuid())
  userId                String
  draftId               String? // Link back to the draft this was published from
  parentPostId          String? // For Twitter threads: link to the parent post (summary)
  threadOrder           Int? // For Twitter threads: 0 = summary, 1+ = replies (order within thread)
  platform              String // "linkedin" | "twitter" | "facebook" | "instagram" | "telegram" | "threads"
  content               String               @db.Text // The actual content that was published
  publishedAt           DateTime? // When the post was actually published (nullable for scheduled posts)
  scheduledAt           DateTime? // When the post is scheduled to be published
  postUrl               String? // URL to the published post (if available from API)
  tweetId               String? // Twitter/X tweet ID (for replies and verification)
  imageUrl              String? // URL of image published with this post (Supabase Storage URL)
  postType              String? // quote | carousel | video_reel | hook_video | ...
  mediaUrls             String[]             @default([]) // carousel / multi-image
  videoUrl              String?
  postAsStory           Boolean              @default(false)
  provider              String? // ghl | direct
  ghlPostId             String?
  automationRunId       String?
  automationRun         SocialAutomationRun? @relation(fields: [automationRunId], references: [id], onDelete: SetNull)
  slotKey               String? // F1..S6 for automation posts
  status                String               @default("published") // ready | scheduled | published | failed | deleted
  errorMsg              String? // If publishing failed, store error
  analyticsLastSyncedAt DateTime? // When analytics were last fetched
  analyticsData         Json? // Store analytics as JSON (platform-specific structure)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  // Relations
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft      Draft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  parentPost Post?  @relation("PostReplies", fields: [parentPostId], references: [id], onDelete: Cascade)
  replies    Post[] @relation("PostReplies")

  @@index([userId, platform, publishedAt])
  @@index([draftId])
  @@index([userId, scheduledAt, status]) // For calendar queries
  @@index([parentPostId]) // For thread queries
  @@index([tweetId]) // For quick tweet ID lookups
  @@index([draftId, threadOrder]) // For thread ordering
  @@index([provider, status])
  @@index([automationRunId])
  @@map("posts")
}

model SocialAutomationRun {
  id             String                       @id @default(cuid())
  userId         String
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null = the standard day-1 slot set for the weekday. 'article_day2' =
  // azavea companion run (publish day + 1) using the unused-sections set.
  slotVariant    String?
  jobId          String?
  job            ArticleJob?                  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  sitePageId     String?
  sitePage       SitePage?                    @relation(fields: [sitePageId], references: [id], onDelete: SetNull)
  // Newsletter-sourced runs (weekly cadence Mon/Wed/Fri/Sat). A run is sourced by
  // EITHER an article (jobId/sitePageId) OR a newsletter (newsletterId).
  newsletterId   String?
  newsletter     Newsletter?                  @relation(fields: [newsletterId], references: [id], onDelete: SetNull)
  scheduledDate  String // YYYY-MM-DD in user's social timezone
  status         String                       @default("pending") // pending | processing | ready | scheduling | completed | failed | cancelled
  totalSpecs     Int                          @default(3)
  completedSpecs Int                          @default(0)
  failedSpecs    Int                          @default(0)
  currentSpec    String?
  error          String?                      @db.Text
  groupId        String?
  slideCount     Int? // shared F4/F6 carousel + hook slide count (6–12), set once per run
  // Auto-recovery (social-automation-safety sweeper): bounded retry count for a
  // stalled run before giving up and alerting for manual review.
  autoRecoverAttempts Int                     @default(0)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  posts          Post[]
  specResults    SocialAutomationSpecResult[]

  @@index([userId, status])
  @@index([jobId])
  @@index([status, updatedAt])
  @@map("social_automation_runs")
}

model SocialAutomationSpecResult {
  id           String              @id @default(cuid())
  runId        String
  run          SocialAutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  slotKey      String
  status       String              @default("pending") // pending | completed | failed
  error        String?             @db.Text
  postsCreated Int                 @default(0)
  assetsJson   Json?
  previewJson  Json? // per-platform captions + media for workflow preview (pre-GHL)
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([runId, slotKey])
  @@index([runId, status])
  @@map("social_automation_spec_results")
}

model SocialPostSpec {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotKey    String // F1..F6, S1..S6
  enabled    Boolean  @default(true)
  timeHour   Int
  timeMinute Int
  postType   String // quote | video_reel | carousel | hook_video | quote_video | pitch_carousel | pitch_hook
  isStory    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, slotKey])
  @@map("social_post_specs")
}

model GhlSettings {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ghlApiKey           String?   @db.Text // AES-256-GCM encrypted Private Integration key OR OAuth location token
  // 'pi' = permanent Private Integration key; 'oauth' = app location token
  // auto-minted from the agency grant (auto-provisioning), refreshed on expiry.
  ghlAuthType         String    @default("pi")
  ghlTokenExpiresAt   DateTime?
  ghlLocationId       String?
  ghlUserId           String? // GHL team member who owns created posts
  accountIds          Json? // { facebook?: string, instagram?: string, linkedin?: string }
  lastVerifiedAt      DateTime?
  lastError           String?
  // Promotional email automation (one campaign per published article, sent to a tag/smart list)
  promoEmailEnabled   Boolean   @default(true)
  promoEmailTagId     String?
  promoEmailTagName   String?
  promoEmailSendTime  String?   @default("09:00") // "HH:mm" 24h, in promoEmailTimezone
  promoEmailTimezone  String?   @default("America/New_York")
  promoEmailFromName  String?
  promoEmailFromEmail String?
  // Magazine newsletter delivery (one GHL email campaign per approved edition)
  newsletterTagId     String?
  newsletterTagName   String?
  newsletterSendTime  String?   @default("09:00") // "HH:mm" 24h, in newsletterTimezone
  newsletterTimezone  String?   @default("America/New_York")
  newsletterFromName  String?
  newsletterFromEmail String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("ghl_settings")
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String // openai, anthropic, etc.
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Settings {
  id                            String   @id @default(cuid())
  userId                        String   @unique
  theme                         String   @default("light")
  sidebarState                  String   @default("open")
  defaultProvider               String? // openai, anthropic, gemini, openrouter
  defaultModel                  String?  @db.Text // JSON string: {"openai": "gpt-4o-mini", "anthropic": "claude-3-5-sonnet-20241022", ...}
  defaultImageProvider          String? // fal, openai-dalle, replicate
  defaultImageModel             String?  @db.Text // JSON string with model per provider: {"fal": "fal-ai/flux/schnell", "openai-dalle": "dall-e-3", ...}
  defaultImageStyle             String?  @db.Text // Default style instructions for image generation
  defaultImagePromptLlmProvider String? // LLM provider for image prompt generation (openai, anthropic, gemini, openrouter)
  defaultImagePromptLlmModel    String? // LLM model for image prompt generation
  writingStyle                  String?  @db.Text // Writing style description for AI-generated posts
  telegramChatId                String? // Default Telegram channel/chat ID (e.g., "@channelname" or numeric ID)
  // Per-user ElevenLabs voiceover (Wave 2)
  elevenLabsVoiceId             String?
  elevenLabsModelId             String?  @default("eleven_multilingual_v2")
  voiceoverEnabled              Boolean  @default(false)
  voiceoverStability            Float    @default(0.5)
  voiceoverSimilarity           Float    @default(0.75)
  voiceoverSpeed                Float    @default(1.0)
  socialTimezone                String?  @default("America/New_York")
  socialAutomationEnabled       Boolean  @default(true)
  // Standing preference (see .plans/client-story-review-mining.implementation-plan.md): when true,
  // a new billing cycle's content generates automatically once review-spidering completes for it.
  autoGenerateNextCycle         Boolean  @default(false)
  lastLogin                     DateTime @default(now())
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Template {
  id                String   @id @default(cuid())
  userId            String
  name              String
  tone              String // professional, casual, inspirational, question-based, storytelling
  description       String
  linkedinTemplate  String   @db.Text
  twitterTemplate   String   @db.Text
  facebookTemplate  String?  @db.Text
  instagramTemplate String?  @db.Text
  telegramTemplate  String?  @db.Text
  threadsTemplate   String?  @db.Text
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ensure only one default template per user
  @@index([userId, isDefault])
  @@map("templates")
}

model SocialConnection {
  id               String    @id @default(cuid())
  userId           String
  platform         String // "linkedin" | "twitter" | "facebook" | "instagram" | "threads" (Note: Telegram uses ApiKey, not OAuth)
  appType          String? // "personal" | "company" - for LinkedIn to distinguish between Personal Profile and Company Pages apps (null for other platforms)
  accessToken      String    @db.Text // OAuth access token (encrypted)
  refreshToken     String?   @db.Text // OAuth refresh token (encrypted, if applicable)
  tokenExpiry      DateTime? // When the access token expires
  platformUserId   String? // The user's ID on the social platform
  platformUsername String? // The user's username/handle
  postTargetType   String? // "personal" | "page" - for LinkedIn and Facebook
  selectedPageId   String? // The selected page ID (for LinkedIn Company Pages or Facebook Pages)
  isActive         Boolean   @default(true) // Can be disabled without deleting
  lastUsed         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One connection per platform per user (for LinkedIn, one per appType: 'personal' or 'company')
  // For other platforms, appType is null, so only one connection per platform
  @@unique([userId, platform, appType])
  @@index([userId, isActive])
  @@index([userId, platform, appType])
  @@map("social_connections")
}

model TwitterApiRequest {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String // e.g., "POST /2/tweets", "POST /2/media/upload"
  statusCode   Int? // HTTP status code (null if request failed before response)
  success      Boolean // Whether the request succeeded
  errorMessage String?  @db.Text // Error message if failed
  requestedAt  DateTime @default(now()) // When the request was made

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@map("twitter_api_requests")
}

// Replaces the in-memory Map in src/lib/oauth.ts with a durable, multi-instance-safe store.
// States expire after 10 minutes; a cleanup job purges rows older than expiresAt.
model OAuthState {
  state        String   @id
  clerkId      String
  platform     String // "linkedin" | "twitter" | "facebook" | "instagram" | "threads"
  codeVerifier String?
  target       String? // "personal" | "company" (LinkedIn only)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@index([clerkId, platform])
  @@map("oauth_states")
}

// ─────────────────────────────────────────────
// Article Pipeline
// ─────────────────────────────────────────────

model Media {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  s3Key    String
  url      String
  altText  String?
  mimeType String?
  width    Int?
  height   Int?

