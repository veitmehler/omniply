model BrandSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Article brand context (used by prompt variable resolver)
  geolocation           String? @db.Text
  industry              String? @db.Text // e.g. Chiropractic, Accounting — primes LLM prompts
  specialization        String? @db.Text // legacy free-text (fallback for {{specialization}}); superseded by primarySpecialization
  // Deterministic specializations (Specialization.key). Multi-select; one primary
  // drives the newsletter calendar. hemisphereOverride applies only for edge countries.
  specializations       String[] // selected Specialization.key values
  primarySpecialization String? // the primary Specialization.key (drives calendar routing + {{specialization}})
  hemisphereOverride    String? // 'north' | 'south' — honored only when the client's country is an edge country
  businessDescription   String? @db.Text // free-text: what the business does, who it serves
  who                   String? @db.Text // target audience description
  ourExperience         String? @db.Text // firm / author experience blurb
  articleGoal           String? @db.Text // strategic goal of each article
  specialInstructions   String? @db.Text // global special instructions injected into every article
  defaultAuthorName     String?
  defaultAuthorWebsite  String?
  defaultAuthorLinkedIn String? // personal LinkedIn URL for schema + author profile
  defaultAuthorJobTitle String? // e.g. "Chiropractor" — author.jobTitle in JSON-LD
  defaultAuthorAlumniOf String? // institution name — author.alumniOf in JSON-LD
  schemaArticleType     String? // override auto-derived @type, e.g. "MedicalArticle"

  // Organization / schema markup fields (used in Wave 4)
  organizationName         String?
  organizationWebsite      String?
  organizationEmail        String?
  organizationPhone        String?
  // Structured address — sub-fields (new); combined string kept for backward compat
  addressLine1             String?
  addressLine2             String?
  addressLocality          String? // city
  addressRegion            String? // state / province
  postalCode               String?
  addressCountryName       String? // full country name, e.g. "Australia"
  organizationAddress      String? @db.Text // computed combined string (legacy + fallback)
  organizationCountryCode  String? @db.VarChar(2) // ISO 3166-1 alpha-2, auto-derived from addressCountryName
  organizationLogoUrl      String? // CDN URL for the business logo (used in schema publisher.logo)
  socialProfileUrls        String[] @default([]) // org social profile URLs → publisher.sameAs in JSON-LD (alongside GBP)
  storyNarratorName        String? // first-person narrator for story-arc posts (falls back to defaultAuthorName)
  storyBeats               String? @db.Text // REAL owner story moments (newline-separated) — the arc generator's authenticity pool
  socialLogoUrl            String? // optional override for social quote cards / compositors; falls back to organizationLogoUrl
  socialAccountName        String? // social handle / display name for quote cards (e.g. "hormozi"); falls back to organizationName
  instagramVerified        Boolean @default(false) // show Instagram-style blue verified badge on quote cards
  videoSpecialInstructions String? @db.Text // client-specific instructions injected into the Fal.ai video prompt (e.g. style, restrictions)
  socialCallToAction       String? @db.Text // what the social posts should promote / drive toward (injected as {{call_to_action}})
  // Universal CTA destination (onboarding "where should bookings go?") — the
  // clinic's PMS online-booking URL. GHL never owns booking (snapshot guide).
  bookingUrl               String?
  // Practice-management system (onboarding dropdown) — market-research capture
  // that decides which PMS connector gets built first (pms-connector plan).
  pmsSystem                String?
  // Weekly opening hours (Places API lookup at onboarding, owner-editable).
  // Optional everywhere: consumers DROP the hours line when null.
  openingHours             String? @db.Text
  clinicFaqs               Json? // logistics-only Q&A [{q,a}] for FAQPage schema (agent plan 3.1; never clinical)
  // Google Place ID (resolved once from googleBusinessProfileUrl or name+address).
  // Drives the review deep link (QR card) + the weekly Places review probe.
  googlePlaceId            String?
  socialPrimaryGoal        String? // link-in-bio CTA goal: 'newsletter' | 'booking' | 'custom' | 'dm_keyword' (null → use socialCallToAction verbatim)
  socialBioUrl             String? @db.Text // the business's link-in-bio page URL (reference; posts say "link in bio")
  googleBusinessProfileUrl String? // GBP / g.page / Maps share URL → sameAs + hasMap in JSON-LD
  socialMediaLinks         Json? // [{ platform: string, url: string }]

  // Mermaid diagrams (article enrichment — theme injected into %%{init}%% )
  diagramPrimaryColor     String?
  diagramPrimaryTextColor String?
  diagramSecondaryColor   String?
  diagramLineColor        String?
  diagramTextColor        String?
  diagramFontFamily       String?
  // AI diagram restyle (Nano Banana): per-business style guide. Empty → server default.
  diagramStyleGuide       String? @db.Text
  // Watermark logo variant for restyled diagrams: 'light' (dark bg, default) | 'dark'.
  diagramLogoVariant      String?
  // Cached light/dark transparent variants auto-generated from organizationLogoUrl
  // when no newsletter logo variants exist. Source tracked to detect staleness.
  diagramLogoSourceUrl    String?
  diagramLogoLightUrl     String?
  diagramLogoDarkUrl      String?

  // Article typography (standalone HTML export only — not WordPress)
  articleFontFamily   String?
  articleFontWeight   String?
  articleFontSizeBase String?

  // Newsletter email template (end-user customizable; renderer supplies sensible defaults)
  nlHeaderBgColor     String?
  nlFooterBgColor     String?
  nlFontFamily        String?
  nlFontColor         String?
  nlHeadingFontWeight String?
  nlBodyFontWeight    String?
  nlLinkColor         String?
  nlButtonColor       String? // CTA/read-more button color (falls back to nlLinkColor)
  nlButtonTextColor   String? // button label color (white or dark header ink), contrast-computed
  // Four content-section band colors (cycled) + header logo (header band only)
  nlSectionColor1     String?
  nlSectionColor2     String?
  nlSectionColor3     String?
  nlSectionColor4     String?
  nlLogoUrl           String? // legacy single newsletter logo (read fallback)
  nlLogoWidth         Int? // header logo width (px)
  // Auto-generated light/dark logo variants (one upload → white + navy transparent)
  nlLogoSourceUrl     String? // original upload, kept so re-processing needs no re-upload
  nlLogoLightUrl      String? // white-on-transparent (for dark backgrounds)
  nlLogoDarkUrl       String? // navy-on-transparent (for light backgrounds)
  nlHeaderLogoVariant String? // 'auto' | 'light' | 'dark' (default auto)
  nlFooterLogoVariant String? // 'auto' | 'light' | 'dark' (default auto)
  nlFooterLogoWidth   Int? // footer logo width (px)
  nlFooterDisclaimer  String? @db.Text // editable footer disclaimer (renderer has a default)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_settings")
}

// ─────────────────────────────────────────────
// Newsletter Pipeline (magazine-style)
// ─────────────────────────────────────────────

// Admin-managed content calendar, scoped per industry + specialization.
// Topics are uploaded via CSV; customers are explicitly assigned to a calendar.
// Admin-managed list of available specializations (deterministic; replaces the
// old free-text specialization). `key` is an immutable slug referenced by
// calendars + clients; `label` is the display name.
model Specialization {
  id        String   @id @default(cuid())
  key       String   @unique // immutable slug, e.g. "family_care"
  label     String // display name, e.g. "Family Care"
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("specializations")
}

model NewsletterCalendar {
  id              String            @id @default(cuid())
  name            String
  industry        String // matches BrandSettings.industry
  specializationKey String? // → Specialization.key
  hemisphere      String? // 'north' | 'south'
  topics          NewsletterTopic[]
  assignments     User[]            @relation("UserNewsletterCalendar")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([specializationKey, hemisphere])
  @@map("newsletter_calendars")
}

// One dated edition's source content (one CSV row). Optional columns drive
// industry modules / secondary article purely by presence.
//
// Two flavors of row, distinguished by which FK is set (see
// .plans/newsletter-topic-override.implementation-plan.md):
//  - admin-curated: calendarId set, accountId null — shared across every account
//    routed to that calendar.
//  - account override: accountId set, calendarId null — one account opted out of
//    the shared calendar for that date with their own idea-bank topic. bullet1-3
//    start as '' and are filled by the nl_topic_expand auto-draft step at
//    generation time (see draftedAt), not at assignment time.
model NewsletterTopic {
  id               String             @id @default(cuid())
  calendarId       String?
  calendar         NewsletterCalendar? @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  accountId        String?
  account          Account?           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourceTopicId    String? // the idea-bank Topic.id this was assigned from (traceability)
  draftedAt        DateTime? // set once nl_topic_expand has filled bullet1-3/etc; null = not yet drafted
  date             DateTime
  topic            String // feature article
  bullet1          String
  bullet2          String
  bullet3          String
  secondaryTopic   String? // → second (specialization) article; CSV column `secondary_article`
  recipe           String? // recipe #1 hint; CSV column `recipe`
  recipe2          String? // recipe #2 hint; CSV column `recipe_2`
  videoUrl         String? // explicit video override
  // shared research write-back (computed once, reused across customers in this calendar)
  research         Json? // { video:{...}, recipe:{...}, teaserSources:[{bullet,url,extract}] }
  researchStatus   String             @default("pending") // pending|complete|partial|failed
  newsletters      Newsletter[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([calendarId, date])
  @@unique([accountId, date])
  @@index([calendarId])
  @@index([accountId])
  @@map("newsletter_topics")
}

// De-identified client story mined from Google reviews, fed into the article pipeline's
// {{real_case_studies}} slot when a topic doesn't already have one of its own. See
// .plans/client-story-review-mining.implementation-plan.md.
model ClientStory {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  storyText      String    @db.Text // de-identified narrative — no names, no stars, no "a reviewer wrote"
  topicTags      String[] // 2-4 keywords from triage, used for topic-matching at generation time
  sourceReviewId String    @unique
  sourceReview   RawReview @relation(fields: [sourceReviewId], references: [id], onDelete: Cascade)
  lastUsedAt     DateTime? // null = never used; gates the once-a-month cap
  useCount       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([accountId, lastUsedAt])
  @@map("client_stories")
}

// Every uniquely-fingerprinted Google review ever transcribed for an account, story or not — lets
// triage be re-run later (e.g. a better prompt) without re-scraping.
model RawReview {
  id           String       @id @default(cuid())
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fingerprint  String // sha256(normalize(reviewerName) + '|' + normalize(reviewText))
  reviewText   String       @db.Text
  starRating   Int?
  relativeDate String? // "2 weeks ago" — logging/debugging only, never a cursor
  triageStatus String       @default("pending") // pending | story | not_story
  clientStory  ClientStory?
  capturedAt   DateTime     @default(now())

  @@unique([accountId, fingerprint])
  @@map("raw_reviews")
}

// One billing cycle's review-spidering attempt for an account — the idempotent dedup key for the
// rollover trigger AND the queryable signal the article-generation gate waits on.
model ClientStorySpiderRun {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cycleStart  DateTime // billingWindows().from for the cycle this run is for
  status      String    @default("running") // running | completed | failed
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([accountId, cycleStart])
  @@map("client_story_spider_runs")
}

// Global, admin-managed per-industry exemplar bank + advertising-claim restrictions
// for plain-language metaphor generation. Clients never see or edit this. When no
// row matches an account's industry, the whole injection pass silently skips.
// See .plans/plain-language-storytelling.implementation-plan.md.
model PlainLanguageConfig {
  id           String   @id @default(cuid())
  industry     String   @unique // matched case-insensitively against BrandSettings.industry
  exemplars    Json // Array<{ kind: 'term'|'concept', subject: string, metaphor: string, note?: string }>
  restrictions String   @db.Text // advertising-claim limitation instructions injected into every generation
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("plain_language_config")
}

// Per-run record of injected plain-language blocks (observability + admin QA).
// Wiped and re-created by each enrichment run, same lifecycle as SectionEnrichment.
model PlainLanguageBlock {
  id              String   @id @default(cuid())
  sitePageId      String
  sitePage        SitePage @relation(fields: [sitePageId], references: [id], onDelete: Cascade)
  sectionPosition Int
  kind            String // 'term' | 'concept'
  subject         String // the term itself, or a one-line concept summary
  label           String? // rotated box label used (concept boxes only)
  generatedText   String   @db.Text
  verified        Boolean  @default(false)
  llmProvider     String?
  llmModel        String?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cost            Float    @default(0)
  createdAt       DateTime @default(now())

  @@index([sitePageId])
  @@map("plain_language_blocks")
}

// A bulk content-generation batch kicked off from the content plan. Items run
// sequentially (one per account at a time); when all reach ready/flagged, a
// single "ready to review" email is sent.
model ContentBatch {
  id              String             @id @default(cuid())
  accountId       String
  createdByUserId String
  status          String             @default("running") // running | completed
  createdAt       DateTime           @default(now())
  completedAt     DateTime?
  items           ContentBatchItem[]

  @@index([accountId])
  @@index([status])
  @@map("content_batches")
}

model ContentBatchItem {
  id                String       @id @default(cuid())
  batchId           String
  batch             ContentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  kind              String // 'article' | 'newsletter'
  date              DateTime
  topicId           String? // article source Topic
  articleJobId      String? // article job once started
  newsletterTopicId String? // newsletter source NewsletterTopic
  newsletterId      String? // Newsletter row once started
  status            String       @default("pending") // pending | generating | ready | flagged | failed
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([batchId])
  @@map("content_batch_items")
}

// Admin-curated article content calendar — same specialization × hemisphere
// routing as newsletters, but SEPARATE (article cadence/fields differ). Accounts
// are auto-routed via Account.articleCalendarId. Topics uploaded via CSV.
model ArticleCalendar {
  id                String                 @id @default(cuid())
  name              String
  industry          String
  specializationKey String? // → Specialization.key
  hemisphere        String? // 'north' | 'south'
  topics            ArticleCalendarTopic[]
  accounts          Account[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([specializationKey, hemisphere])
  @@map("article_calendars")
}

// One dated, pre-planned article topic (one CSV row). Article-shaped fields.
model ArticleCalendarTopic {
  id                     String          @id @default(cuid())
  calendarId             String
  calendar               ArticleCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  date                   DateTime
  topic                  String // the article angle / working title
  angle                  String?         @db.Text // optional fuller brief / sub-angles
  keywords               String[]        @default([]) // optional target keywords
  outlineFrameworkNumber Int? // optional preferred outline framework
  category               String? // optional WP category hint
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([calendarId, date])
  @@index([calendarId])
  @@map("article_calendar_topics")
}

// Per-customer voiced newsletter for one topic. JSON per section so a
// single-section regenerate writes one column.
model Newsletter {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId          String
  topic            NewsletterTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status           String          @default("pending") // pending|researching|generating|ready_for_review|approved|scheduled|sent|failed
  // voiced content — JSON per section
  featureArticle   Json? // {title,teaser,tldr,body,imageUrl}
  secondaryArticle Json?
  teasers          Json? // [{title,body,cta,link} ×3]
  quickHits        Json? // {tips:[..4], facts:[..4]}
  storyArcJson     Json? // generated story-arc beats (engagement v2, main-app phase)
  fun              Json? // {triviaQuestion,triviaAnswer,joke}
  modules          Json? // {recipe?,recipe2?}
  subjectLine      String?
  previewText      String?
  summaryTitle     String? // LLM 3-word cover title
  summaryImageUrl  String?         @db.Text // composited cover image URL
  renderedHtml     String?         @db.Text
  validation       Json? // completion score + issues
  // delivery
  ghlCampaignId    String?
  scheduledFor     DateTime?
  sentAt           DateTime?
  approvedAt       DateTime?
  // Set when the batch "ready for review" email has been sent for this edition
  // (prevents re-notifying on subsequent batch completions).
  notifiedAt       DateTime?
  // cost
  cost             Float           @default(0)
  inputTokens      Int             @default(0)
  outputTokens     Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  socialRuns       SocialAutomationRun[]

  @@unique([userId, topicId])
  @@index([userId, status])
  @@index([topicId])
  @@map("newsletters")
}

// Per-customer promotional offers included in their newsletter. Evergreen
// (no dates) render after the feature article; seasonal (date window) render
// after "Tips Of The Day" and auto-expire.
model NewsletterOffer {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  ctaLabel  String?
  ctaUrl    String?
  imageUrl  String?   @db.Text // optional 16:9 banner (AI-generated or uploaded)
  startDate DateTime? // null + null endDate = evergreen
  endDate   DateTime?
  enabled   Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, enabled])
  @@map("newsletter_offers")
}
